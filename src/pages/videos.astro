---
const travelVideos = [
  { id: "KkXJzgt2_Tc", title: "Travel video 1" },
  { id: "OO49iDBrT1U", title: "Travel video 2" },
  { id: "3VkiJxUAXf8", title: "Travel video 3" }
];
const concertVideos = [
  { id: "DdIrhPqFhsw", title: "Concert video 1" },
  { id: "V-XYxkPZ0z8", title: "Concert short 1" },
  { id: "Vm_47B6O9hY", title: "Concert short 2" },
  { id: "-hQLwS3VB3w", title: "Concert video 2" }
];
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Travel videos and concert moments from CYan Travel Journal." />
  <meta name="theme-color" content="#f3fbff" />
  <title>Videos · 虾游记 | CYan Travel Journal</title>
  <style>
    :root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#173746;background:#f3fbff;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0}.wrap{width:min(1120px,calc(100% - 44px));margin:auto}a{color:inherit;text-decoration:none}.top{height:80px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfe5ef}.brand{font-size:19px;font-weight:750}.brand small{display:block;font-size:10px;letter-spacing:.18em;color:#718894;margin-top:4px}.back{font-size:13px;color:#648da5}.intro{padding:48px 0 18px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#648da5;font-weight:700}.intro h1{font:400 clamp(42px,7vw,66px)/1 Georgia,serif;margin:14px 0}.intro p{font-size:15px;line-height:1.8;color:#647d89;max-width:680px}.collection{padding:35px 0 45px;border-top:1px solid #cfe5ef}.collection h2{font:400 34px Georgia,serif;margin:8px 0}.sub{font-size:13px;color:#718894;margin:0 0 22px}.videos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.video{min-width:0}.frame{position:relative;aspect-ratio:16/9;background:#dceef5;border-radius:12px 4px 12px 4px;overflow:hidden;box-shadow:0 12px 30px #27698412}.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.video h3{font-size:14px;font-weight:600;margin:12px 0 0;color:#304956}.open{display:inline-block;margin-top:7px;font-size:12px;color:#648da5}footer{padding:28px 0 40px;border-top:1px solid #cfe5ef;color:#718894;font-size:12px}@media(max-width:650px){.videos{grid-template-columns:1fr}.wrap{width:calc(100% - 36px)}.intro{padding-top:35px}}
[data-lang="zh"] .en{display:none}[data-lang="en"] .zh{display:none}
  </style>
</head>
<body data-lang="en">
<div class="wrap">
  <header class="top"><a class="brand" href="/">🦐游记 <small>CYAN TRAVEL JOURNAL</small></a><a class="back" href="/">← <span class="en">Back to home</span><span class="zh">返回主页</span></a></header>
  <main>
    <section class="intro"><div class="eyebrow">WATCH · REMEMBER · REPLAY</div><h1><span class="en">Videos & Moments</span><span class="zh">视频与精彩瞬间</span></h1><p class="en">A collection of journeys, places and live music moments captured along the way.</p><p class="zh">收藏旅途中的风景、探索片段，以及现场音乐带来的感动。</p></section>
    <section class="collection" id="travel"><div class="eyebrow">ON THE ROAD</div><h2><span class="en">Travel Videos</span><span class="zh">旅途记录</span></h2><p class="sub"><span class="en">Travel vlogs, destinations and little discoveries.</span><span class="zh">旅行 Vlog、目的地风景与沿途发现。</span></p><div class="videos">{travelVideos.map((video) => <article class="video"><div class="frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><a class="open" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a></article>)}</div></section>
    <section class="collection" id="concerts"><div class="eyebrow">LIVE & LOUD</div><h2><span class="en">Concerts & Live Music</span><span class="zh">演唱会与现场音乐</span></h2><p class="sub"><span class="en">Live performances, concert nights and music memories.</span><span class="zh">现场演出、演唱会之夜与音乐回忆。</span></p><div class="videos">{concertVideos.map((video) => <article class="video"><div class="frame"><iframe src={`https://www.youtube-nocookie.com/embed/${video.id}`} title={video.title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><a class="open" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener noreferrer">Watch on YouTube ↗</a></article>)}</div></section>
  </main>
  <footer>© {new Date().getFullYear()} 🦐游记 · CYan Travel Journal</footer>
</div>
</body>
</html>
