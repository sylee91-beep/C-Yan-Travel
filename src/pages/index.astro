---
const trips = [
  { region: "CHINA · 中国", title: "Xinjiang", subtitle: "Mountains, lakes & unexpected turns", chinese: "新疆 · 山川湖泊与旅途中的意外惊喜", image: "/images/xinjiang.jpg", alt: "A traveller and orange 4x4 beside the blue lake in Xinjiang" },
  { region: "MALAYSIA · 马来西亚", title: "Semporna", subtitle: "Blue water, island days & diving", chinese: "仙本那 · 蓝海、海岛与潜水时光", image: "/images/semporna.jpg", alt: "A scuba diver swimming beside a sea turtle over a coral reef" },
  { region: "JAPAN · 日本", title: "Hokkaido", subtitle: "A little winter wonderland", chinese: "北海道 · 冬日雪境", image: "/images/hokkaido.jpg", alt: "A snowboarder on a snowy Hokkaido ski slope" }
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="🦐游记 – CYan Travel Journal. Travel, explore, discover and remember." />
    <meta name="theme-color" content="#f2f8fb" />
    <title>🦐游记 · CYan Travel Journal</title>
    <style>
      :root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#20313a;background:#f2f8fb;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 56px));margin:auto;position:relative;z-index:1}
      .shrimp-pattern{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0;color:#d94a42;opacity:.12;font-size:17px;line-height:1;user-select:none}.shrimp-pattern span{position:absolute}.shrimp-pattern span:nth-child(1){top:13%;left:8%;transform:rotate(-24deg)}.shrimp-pattern span:nth-child(2){top:28%;left:91%;transform:rotate(18deg)}.shrimp-pattern span:nth-child(3){top:49%;left:4%;transform:rotate(35deg)}.shrimp-pattern span:nth-child(4){top:67%;left:86%;transform:rotate(-18deg)}.shrimp-pattern span:nth-child(5){top:82%;left:17%;transform:rotate(12deg)}.shrimp-pattern span:nth-child(6){top:92%;left:69%;transform:rotate(-32deg)}.shrimp-pattern span:nth-child(7){top:38%;left:72%;transform:rotate(28deg)}.shrimp-pattern span:nth-child(8){top:74%;left:48%;transform:rotate(-12deg)}.shrimp-pattern span:nth-child(9){top:6%;left:58%;transform:rotate(14deg)}.shrimp-pattern span:nth-child(10){top:57%;left:97%;transform:rotate(-25deg)}\n      header{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #dce9ef}
      .brand{font-weight:750;letter-spacing:.02em;font-size:20px}.brand small{display:block;font-size:10px;letter-spacing:.18em;color:#718894;font-weight:600;margin-top:4px}
      nav{display:flex;align-items:center;gap:26px;font-size:13px;color:#55594f}nav a:hover{color:#111}
      .lang{border:1px solid #cbdde6;border-radius:99px;padding:8px 13px;background:transparent;cursor:pointer;font:inherit;font-size:12px}
      .hero{padding:58px 0 68px;display:grid;grid-template-columns:1fr 1.02fr;gap:44px;align-items:center}
      .eyebrow{font-size:11px;letter-spacing:.2em;color:#688697;font-weight:700}.hero h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(48px,6.4vw,78px);line-height:.99;letter-spacing:-.055em;margin:22px 0}
      .hero h1 .accent{color:#648da5}.lead{font-size:16px;line-height:1.8;color:#536b78;max-width:490px}.tagline{font-size:14px;margin-top:22px;color:#304956}
      .hero-photo{height:410px;border-radius:5px;overflow:hidden;position:relative;background:#dceef5}.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 60%;display:block}.hero-photo:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(15,30,25,.45))}
      .art-note{position:absolute;z-index:1;bottom:20px;left:22px;color:white;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
      section{padding:42px 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.section-head h2{font:400 34px Georgia,serif;margin:8px 0 0}.muted{color:#718894;font-size:13px}
      .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.trip{min-width:0}.trip-art{height:250px;border-radius:4px;position:relative;overflow:hidden;background:#d9ded8}.trip-art img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}.trip:hover .trip-art img{transform:scale(1.035)}.trip-art:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(20,30,25,.48));pointer-events:none}
      .trip-art span{position:absolute;z-index:1;bottom:16px;left:17px;color:white;font-size:10px;letter-spacing:.16em}.trip h3{font:400 25px Georgia,serif;margin:16px 0 6px}.trip p{font-size:13px;color:#777d72;margin:0;line-height:1.6}
      .about{background:#e7f2f7;padding:38px;border-radius:4px;display:flex;justify-content:space-between;gap:30px;align-items:center}.about h2{font:400 30px Georgia,serif;margin:0 0 10px}.about p{max-width:720px;color:#536b78;line-height:1.8;font-size:14px;margin:0}
      .socials{display:flex;gap:10px;flex-wrap:wrap}.socials a{border:1px solid #cbdde6;border-radius:99px;padding:10px 14px;font-size:12px}
      footer{padding:34px 0 42px;color:#718894;font-size:11px;display:flex;justify-content:space-between;border-top:1px solid #dce9ef;margin-top:55px}
      [data-lang="zh"] .en{display:none}[data-lang="en"] .zh{display:none}
      @media(max-width:760px){.shrimp-pattern{opacity:.08;font-size:14px}.wrap{width:calc(100% - 36px)}header{height:72px}nav{gap:12px}nav a{display:none}.hero{grid-template-columns:1fr;padding:42px 0 26px;gap:26px}.hero-photo{height:270px}.cards{grid-template-columns:1fr;gap:28px}.trip-art{height:250px}.about{display:block;padding:26px}.socials{margin-top:22px}footer{gap:15px;flex-direction:column}}
    </style>
  </head>
  <body data-lang="en">\n    <div class="shrimp-pattern" aria-hidden="true"><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span></div>
    <div class="wrap">
      <header>
        <a class="brand" href="/">🦐游记 <small>CYAN TRAVEL JOURNAL</small></a>
        <nav aria-label="Main navigation">
          <a href="#journeys"><span class="en">Journeys</span><span class="zh">旅程</span></a>
          <a href="#about"><span class="en">About</span><span class="zh">关于</span></a>
          <a href="#social"><span class="en">Follow</span><span class="zh">关注</span></a>
          <button class="lang" id="language-toggle" type="button">中文</button>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div>
            <div class="eyebrow">TRAVEL · EXPLORE · DISCOVER · REMEMBER</div>
            <h1><span class="en">A little less plan.<br/>A lot more <span class="accent">瞎玩.</span></span><span class="zh">不一定有计划，<br/>但一定有故事。</span></h1>
            <p class="lead en">A personal travel journal for curious detours, unexpected discoveries and the stories collected along the way.</p>
            <p class="lead zh">记录每一段旅程、每一次随性出发，以及那些意想不到的风景与故事。</p>
            <p class="tagline en">CYan Travel Journal · Travel your way.</p>
            <p class="tagline zh">虾游记 · 随心出发，尽情瞎玩。</p>
          </div>
          <div class="hero-photo"><img src="/images/xinjiang.jpg" alt="A traveller and orange 4x4 beside the blue lake in Xinjiang" /><div class="art-note">Collect moments, not just miles</div></div>
        </section>
        <section id="journeys">
          <div class="section-head"><div><div class="eyebrow">THE TRAVEL LOG</div><h2><span class="en">Recent journeys</span><span class="zh">近期旅程</span></h2></div><span class="muted"><span class="en">More stories coming soon</span><span class="zh">更多故事，陆续更新</span></span></div>
          <div class="cards">
            {trips.map((trip) => <article class="trip"><div class="trip-art"><img src={trip.image} alt={trip.alt} loading="lazy" /><span>{trip.region}</span></div><h3>{trip.title}</h3><p class="en">{trip.subtitle}</p><p class="zh">{trip.chinese}</p></article>)}
          </div>
        </section>
        <section id="about">
          <div class="about">
            <div><h2><span class="en">Not every trip needs a plan.</span><span class="zh">关于虾游记</span></h2><p class="en">“虾” is a playful nod to both 虾游 (travel) and 瞎玩 (going out, exploring and having fun without overthinking it). This is a place to keep the journeys, little discoveries and memories worth remembering.</p><p class="zh">「虾」既是虾游，也是瞎玩。这里记录随性出发的旅程、沿途发现的小惊喜，以及值得珍藏的回忆。不必每一步都计划好，旅途自然会有故事。</p></div>
          </div>
        </section>
        <section id="social">
          <div class="section-head"><div><div class="eyebrow">ELSEWHERE ONLINE</div><h2><span class="en">Follow the adventures</span><span class="zh">社交平台</span></h2></div></div>
          <p class="muted en">Social links and selected post embeds will be added here once your profile URLs are ready.</p><p class="muted zh">待提供个人主页链接后，我们会在这里加入社交平台入口及精选贴文。</p>
          <div class="socials"><a href="#" aria-label="Instagram profile – to be configured">Instagram ↗</a><a href="#" aria-label="Facebook profile – to be configured">Facebook ↗</a><a href="#" aria-label="Xiaohongshu profile – to be configured">小红书 ↗</a></div>
        </section>
      </main>
      <footer><span>© {new Date().getFullYear()} 🦐游记 · CYan Travel Journal</span><span>Travel, Explore, Discover & Remember</span></footer>
    </div>
    <script>
      const toggle = document.querySelector('#language-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.body.dataset.lang === 'en' ? 'zh' : 'en';
        document.body.dataset.lang = next;
        toggle.textContent = next === 'en' ? '中文' : 'English';
        document.documentElement.lang = next;
      });
    </script>
  </body>
</html>