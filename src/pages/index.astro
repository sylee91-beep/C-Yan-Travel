---
const trips = [
  { region: "CHINA · 中国", title: "Xinjiang", subtitle: "Mountains, lakes & unexpected turns", chinese: "新疆 · 山川湖泊与旅途中的意外惊喜", image: "/images/xinjiang.jpg", alt: "A traveller and orange 4x4 beside the blue lake in Xinjiang" },
  { region: "MALAYSIA · 马来西亚", title: "Semporna", subtitle: "Blue water, island days & diving", chinese: "仙本那 · 蓝海、海岛与潜水时光", image: "/images/semporna.jpg", alt: "A scuba diver swimming beside a sea turtle over a coral reef" },
  { region: "JAPAN · 日本", title: "Hokkaido", subtitle: "A little winter wonderland", chinese: "北海道 · 冬日雪境", image: "/images/hokkaido.jpg", alt: "A snowboarder on a snowy Hokkaido ski slope" }
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="🦐游记 – CYan Travel Journal. Travel, explore, discover and remember." />
    <meta name="theme-color" content="#f2f8fb" />
    <title>🦐游记 · CYan Travel Journal</title>
    <style>
      :root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#173746;background:#f3fbff;font-synthesis:none;text-rendering:optimizeLegibility}
      *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}.wrap{width:min(1180px,calc(100% - 56px));margin:auto;position:relative;z-index:1}
      .shrimp-pattern{position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0;color:#df594b;opacity:.19;font-size:21px;line-height:1;user-select:none}.shrimp-pattern span{position:absolute}.shrimp-pattern span:nth-child(1){top:13%;left:8%;transform:rotate(-24deg)}.shrimp-pattern span:nth-child(2){top:28%;left:91%;transform:rotate(18deg)}.shrimp-pattern span:nth-child(3){top:49%;left:4%;transform:rotate(35deg)}.shrimp-pattern span:nth-child(4){top:67%;left:86%;transform:rotate(-18deg)}.shrimp-pattern span:nth-child(5){top:82%;left:17%;transform:rotate(12deg)}.shrimp-pattern span:nth-child(6){top:92%;left:69%;transform:rotate(-32deg)}.shrimp-pattern span:nth-child(7){top:38%;left:72%;transform:rotate(28deg)}.shrimp-pattern span:nth-child(8){top:74%;left:48%;transform:rotate(-12deg)}.shrimp-pattern span:nth-child(9){top:6%;left:58%;transform:rotate(14deg)}.shrimp-pattern span:nth-child(10){top:57%;left:97%;transform:rotate(-25deg)}.shrimp-pattern span:nth-child(11){top:20%;left:48%;color:#70b4ce;font-size:14px}.shrimp-pattern span:nth-child(12){top:42%;left:30%;color:#70b4ce;font-size:28px}.shrimp-pattern span:nth-child(13){top:88%;left:91%;color:#70b4ce;font-size:16px}.shrimp-pattern span:nth-child(14){top:7%;left:83%;color:#70b4ce;font-size:24px}
      header{height:82px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #cfe5ef}
      .brand{font-weight:750;letter-spacing:.02em;font-size:20px}.brand small{display:block;font-size:10px;letter-spacing:.18em;color:#718894;font-weight:600;margin-top:4px}
      nav{display:flex;align-items:center;gap:26px;font-size:13px;color:#55594f}nav a:hover{color:#111}
      .lang{border:1px solid #cbdde6;border-radius:99px;padding:8px 13px;background:transparent;cursor:pointer;font:inherit;font-size:12px}
      .hero{padding:58px 0 68px;display:grid;grid-template-columns:1fr 1.02fr;gap:44px;align-items:center;position:relative}.hero:before{content:"";position:absolute;z-index:-1;inset:8px -8vw 18px;border-radius:48% 52% 0 0 / 8% 10% 0 0;background:linear-gradient(180deg,rgba(218,241,250,.62),rgba(243,251,255,0));pointer-events:none}
      .eyebrow{font-size:11px;letter-spacing:.2em;color:#688697;font-weight:700}.hero h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(48px,6.4vw,78px);line-height:.99;letter-spacing:-.055em;margin:22px 0}
      .hero h1 .accent{color:#648da5}.lead{font-size:16px;line-height:1.8;color:#536b78;max-width:490px}.tagline{font-size:14px;margin-top:22px;color:#304956}
      .hero-photo{height:410px;border-radius:18px 4px 18px 4px;overflow:hidden;position:relative;background:#dceef5;box-shadow:0 18px 45px rgba(39,105,132,.12)}.hero-photo img{width:100%;height:100%;object-fit:cover;object-position:center 60%;display:block}.hero-photo:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(15,30,25,.45))}
      .art-note{position:absolute;z-index:1;bottom:20px;left:22px;color:white;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
      section{padding:48px 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.section-head h2{font:400 34px Georgia,serif;margin:8px 0 0}.muted{color:#718894;font-size:13px}
      .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.trip{min-width:0}.trip-art{height:250px;border-radius:12px 3px 12px 3px;position:relative;overflow:hidden;background:#d9ded8}.trip-art img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}.trip:hover .trip-art img{transform:scale(1.035)}.trip-art:after{content:"";position:absolute;inset:45% 0 0;background:linear-gradient(transparent,rgba(20,30,25,.48));pointer-events:none}
      .trip-art span{position:absolute;z-index:1;bottom:16px;left:17px;color:white;font-size:10px;letter-spacing:.16em}.trip h3{font:400 25px Georgia,serif;margin:16px 0 6px}.trip>a:hover h3{color:#648da5}.trip p{font-size:13px;color:#777d72;margin:0;line-height:1.6}
      .about{background:linear-gradient(135deg,#e4f5fb,#cce9f4);padding:38px;border-radius:18px 4px 18px 4px;display:flex;justify-content:space-between;gap:30px;align-items:center}.about h2{font:400 30px Georgia,serif;margin:0 0 10px}.about p{max-width:720px;color:#536b78;line-height:1.8;font-size:14px;margin:0}
      .media-section{padding:42px 0 48px;border-top:1px solid #dce9ef}.media-heading{margin-bottom:22px}.media-heading h2{font:400 34px Georgia,serif;margin:8px 0}.media-group{margin:28px 0 36px}.media-group h3{font:400 24px Georgia,serif;margin:0 0 15px}.media-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.media-card{min-width:0;background:rgba(255,255,255,.58);border:1px solid #d7e9f0;border-radius:12px;overflow:hidden}.media-frame{position:relative;aspect-ratio:16/9;background:#dceef5}.media-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.post-card{display:flex;min-height:112px;flex-direction:column;justify-content:space-between;padding:18px}.post-card p{font-size:13px;line-height:1.6;color:#647d89;margin:0 0 16px}.post-card a{font-size:12px;color:#648da5;font-weight:650}.instagram-card{padding:8px;min-width:0}.instagram-card .instagram-media{margin:0 auto!important;min-width:0!important;width:100%!important;max-width:540px!important}.instagram-grid{grid-template-columns:repeat(2,minmax(0,1fr));align-items:start}.rednote-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.media-note{font-size:12px;color:#718894;margin:-5px 0 15px}@media(max-width:760px){.media-grid{grid-template-columns:1fr 1fr}}@media(max-width:480px){.media-grid{grid-template-columns:1fr}}
      .socials{display:flex;gap:10px;flex-wrap:wrap}.socials a{border:1px solid #b9d9e7;border-radius:99px;padding:10px 14px;font-size:12px;background:rgba(255,255,255,.48);transition:background .2s,border-color .2s}.socials a:hover{background:#dff2f9;border-color:#79b5cc}
      footer{padding:34px 0 42px;color:#718894;font-size:11px;display:flex;justify-content:space-between;border-top:1px solid #dce9ef;margin-top:55px}
      [data-lang="zh"] .en{display:none}[data-lang="en"] .zh{display:none}
      @media(max-width:760px){.shrimp-pattern{opacity:.08;font-size:14px}.wrap{width:calc(100% - 36px)}header{height:72px}nav{gap:12px}nav a{display:none}.hero{grid-template-columns:1fr;padding:42px 0 26px;gap:26px}.hero-photo{height:270px}.cards{grid-template-columns:1fr;gap:28px}.trip-art{height:250px}.about{display:block;padding:26px}.socials{margin-top:22px}footer{gap:15px;flex-direction:column}}
    </style>
  </head>
  <body data-lang="en">
    <div class="shrimp-pattern" aria-hidden="true"><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>🦐</span><span>✧</span><span>·</span><span>✧</span><span>·</span></div>
    <div class="wrap">
      <header>
        <a class="brand" href="/">🦐游记 <small>CYAN TRAVEL JOURNAL</small></a>
        <nav aria-label="Main navigation">
          <a href="#journeys"><span class="en">Journeys</span><span class="zh">旅程</span></a>
          <a href="/videos/"><span class="en">Videos</span><span class="zh">视频</span></a>
          <a href="#about"><span class="en">About</span><span class="zh">关于</span></a>
          <a href="#social"><span class="en">Follow</span><span class="zh">关注</span></a>
          <button class="lang" id="language-toggle" type="button">中文</button>
        </nav>
      </header>
      <main>
        <section class="hero">
          <div>
            <div class="eyebrow">TRAVEL · EXPLORE · DISCOVER · REMEMBER</div>
            <h1><span class="en">A little less plan.<br/>A lot more <span class="accent">瞎玩.</span></span><span class="zh">不一定有计划，<br/>但一定有故事。</span></h1>
            <p class="lead en">A personal travel journal for curious detours, unexpected discoveries and the stories collected along the way.</p>
            <p class="lead zh">记录每一段旅程、每一次随性出发，以及那些意想不到的风景与故事。</p>
            <p class="tagline en">CYan Travel Journal · Travel your way.</p>
            <p class="tagline zh">虾游记 · 随心出发，尽情瞎玩。</p>
          </div>
          <div class="hero-photo"><img src="/images/xinjiang.jpg" alt="A traveller and orange 4x4 beside the blue lake in Xinjiang" /><div class="art-note">Collect moments, not just miles</div></div>
        </section>
        <section id="journeys">
          <div class="section-head"><div><div class="eyebrow">THE TRAVEL LOG</div><h2><span class="en">Recent journeys</span><span class="zh">近期旅程</span></h2></div><span class="muted"><span class="en">More stories coming soon</span><span class="zh">更多故事，陆续更新</span></span></div>
          <div class="cards">
            {trips.map((trip) => <article class="trip"><a href={`/journeys/${trip.title.toLowerCase()}/`} aria-label={`Read about ${trip.title}`}><div class="trip-art"><img src={trip.image} alt={trip.alt} loading="lazy" /><span>{trip.region}</span></div><h3>{trip.title} ↗</h3></a><p class="en">{trip.subtitle}</p><p class="zh">{trip.chinese}</p></article>)}
          </div>
        </section>
        <section class="media-section" id="latest-media"><div class="media-heading"><div class="eyebrow">FRESH FROM MY CHANNELS</div><h2><span class="en">Latest posts & videos</span><span class="zh">最新动态与视频</span></h2><p class="muted en">A little more from the journeys, and the music moments in between.</p><p class="muted zh">旅途中的新分享，以及沿途遇见的音乐时刻。</p></div><div class="media-group"><h3><span class="en">Travel Videos · 旅途记录</span><span class="zh">旅途记录</span></h3><div class="media-grid"><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/KkXJzgt2_Tc" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/OO49iDBrT1U" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/3VkiJxUAXf8" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article></div></div><div class="media-group"><h3><span class="en">Concerts & Live Music · 演唱会与现场音乐</span><span class="zh">演唱会与现场音乐</span></h3><div class="media-grid"><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/DdIrhPqFhsw" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/V-XYxkPZ0z8" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/Vm_47B6O9hY" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article><article class="media-card"><div class="media-frame"><iframe src="https://www.youtube-nocookie.com/embed/-hQLwS3VB3w" title="YouTube video" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></article></div></div><div class="media-group"><h3><span class="en">Instagram · 照片分享</span><span class="zh">Instagram · 照片分享</span></h3><p class="media-note"><span class="en">Original posts, displayed directly from Instagram.</span><span class="zh">直接显示 Instagram 原帖内容。</span></p><div class="media-grid instagram-grid"><article class="media-card instagram-card"><blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/p/DfG5EiTTr1M/" data-instgrm-version="14"><a href="https://www.instagram.com/p/DfG5EiTTr1M/" target="_blank" rel="noopener noreferrer">View this post on Instagram</a></blockquote></article><article class="media-card instagram-card"><blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/p/DfB1PlXTkPH/" data-instgrm-version="14"><a href="https://www.instagram.com/p/DfB1PlXTkPH/" target="_blank" rel="noopener noreferrer">View this post on Instagram</a></blockquote></article></div><script async src="https://www.instagram.com/embed.js"></script></div><div class="media-group"><h3><span class="en">小红书 · 旅途笔记</span><span class="zh">小红书 · 旅途笔记</span></h3><p class="media-note"><span class="en">Read the original notes on Rednote.</span><span class="zh">点击卡片，前往小红书阅读原笔记。</span></p><div class="media-grid rednote-grid"><article class="media-card post-card"><p>小红书 · 旅途笔记 01</p><a href="https://www.rednote.com/discovery/item/6ae560f2000000000c03c219?xsec_token=ABmuGKRT_FkPRsbeNamElzdEHJ7s0JThbVLlO0A_zb2bc=&xsec_source=pc_user" target="_blank" rel="noopener noreferrer">查看原笔记 ↗</a></article><article class="media-card post-card"><p>小红书 · 旅途笔记 02</p><a href="https://www.rednote.com/discovery/item/6adce271000000000d009644?xsec_token=ABhJ5h3D9M133OalffXCo9PGU_jWDYGmKZcEtIcvOT7Jo=&xsec_source=pc_user" target="_blank" rel="noopener noreferrer">查看原笔记 ↗</a></article></div></div><p><a class="muted" href="/videos/"><span class="en">Browse all videos →</span><span class="zh">浏览全部视频 →</span></a></p></section>
        <section id="about">
          <div class="about">
            <div><h2><span class="en">Not every trip needs a plan.</span><span class="zh">关于虾游记</span></h2><p class="en">“虾” is a playful nod to both 虾游 (travel) and 瞎玩 (going out, exploring and having fun without overthinking it).<br /><span class="about-following-sentence">This is a place to keep the journeys, little discoveries and memories worth remembering.</span></p><p class="zh">「虾」既是虾游，也是瞎玩。这里记录随性出发的旅程、沿途发现的小惊喜，以及值得珍藏的回忆。不必每一步都计划好，旅途自然会有故事。</p></div>
          </div>
        </section>
        <section id="social">
          <div class="section-head"><div><div class="eyebrow">ELSEWHERE ONLINE</div><h2><span class="en">Follow the adventures</span><span class="zh">社交平台</span></h2></div></div>
          <p class="muted en">Follow along for travel photos, short videos and stories from the road.</p><p class="muted zh">欢迎到我的社交平台，一起分享旅途照片、短视频与沿途故事。</p>
          <div class="socials"><a href="https://www.instagram.com/c_yan18/" target="_blank" rel="noopener noreferrer" aria-label="Follow CYan on Instagram">Instagram ↗</a><a href="https://xhslink.cn/m/830rNsTcCgQ" target="_blank" rel="noopener noreferrer" aria-label="Follow CYan on Xiaohongshu">小红书 ↗</a><a href="https://youtube.com/@cyan1818" target="_blank" rel="noopener noreferrer" aria-label="Visit CYan on YouTube">YouTube ↗</a></div>
        </section>
      </main>
      <footer><span>© {new Date().getFullYear()} 🦐游记 · CYan Travel Journal</span><span>Travel, Explore, Discover & Remember</span></footer>
    </div>
    <script>
      const toggle = document.querySelector('#language-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.body.dataset.lang === 'en' ? 'zh' : 'en';
        document.body.dataset.lang = next;
        toggle.textContent = next === 'en' ? '中文' : 'English';
        document.documentElement.lang = next;
      });
    </script>
  </body>
</html>